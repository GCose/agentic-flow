model OnboardingEvent {
  id        String   @id @default(uuid())
  userId    String
  event     String
  details   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
// Prisma schema for User management

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  emailStatus   String?   // 'sent', 'failed', etc.
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systems   UserSystem[]
  // ...existing code...
  setupToken   String?
  verifyToken  String?
  verified     Boolean   @default(false)
  resetToken        String?
  resetTokenExpiry  DateTime?
  onboardingEvents OnboardingEvent[]
  notifications Notification[] @relation("UserNotifications")
  notificationReads NotificationRead[]
  notificationEnabled Boolean @default(true)

  @@index([role])
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  sendType    String
  targetGroup String
  schedule    DateTime?
  status      String   // sent, scheduled, failed, delivered, opened
  attachment  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]   @relation("UserNotifications")
  reads       NotificationRead[]
}
model NotificationRead {
  id             String   @id @default(uuid())
  userId         String
  notificationId String
  readAt         DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
  notification   Notification @relation(fields: [notificationId], references: [id])

  @@unique([userId, notificationId])
}
// Persistent pending account requests
model PendingAccount {
  id        String   @id @default(uuid())
  name      String
  email     String
  systems   String[]
  createdAt DateTime @default(now())
}
enum Role {
  admin
  client
  designer
  videographer
}


model System {
  id      String   @id @default(uuid())
  name    String   @unique
  users   UserSystem[]
}

model UserSystem {
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  system  System @relation(fields: [systemId], references: [id])
  systemId String

  @@id([userId, systemId])
}
